# Server
PORT=8787
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:8787
CORS_ORIGIN=*

# Local cache DB path
CACHE_DB_PATH=./data/cache.sqlite

# MCP OAuth (this protects /mcp)
# For remote deployments (Claude.ai): set OAUTH_JWT_SECRET and OAUTH_ALLOWED_REDIRECT_URIS.
# Optional static bearer for clients that can't do OAuth (e.g. over a private tailnet).
# Unset = disabled. Bind HOST to a private interface when using it.
# MCP_API_KEY=
OAUTH_ISSUER=http://localhost:8787
OAUTH_AUDIENCE=simplifi-mcp
OAUTH_JWT_SECRET=replace-with-a-long-random-secret
OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# Comma separated callback allowlist. Example:
# OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth/callback
OAUTH_ALLOWED_REDIRECT_URIS=

# Simplifi API settings (reverse-engineered Quicken web client credentials)
SIMPLIFI_BASE_URL=https://services.quicken.com
SIMPLIFI_REDIRECT_URI=https://simplifi.quicken.com/login
SIMPLIFI_CLIENT_ID=acme_web
SIMPLIFI_CLIENT_SECRET=BCDCxXwdWYcj@bK6
SIMPLIFI_HTTP_TIMEOUT_MS=30000

# Optional: pre-seed credentials to avoid the OAuth login page on first run.
# Not needed for remote deployments — the OAuth flow handles login interactively.
# SIMPLIFI_EMAIL=you@example.com
# SIMPLIFI_PASSWORD=your-simplifi-password
# SIMPLIFI_DATASET_ID=500000000000000000

# Sync behavior
SIMPLIFI_SYNC_INTERVAL_MS=60000
SIMPLIFI_MAX_STALE_MS=120000
SIMPLIFI_PAGE_LIMIT=5000
